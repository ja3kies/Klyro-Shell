<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Interactive shell files and plugin/preferences must never be exported automatically. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
